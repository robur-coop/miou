module Bitv = Miou_bitv
module Epoll = Miou_epoll

type kind = STREAM | DGRAM
type file_descr = { fd: Unix.file_descr; kind: kind option; non_blocking: bool }

type bigstring =
  (char, Bigarray.int8_unsigned_elt, Bigarray.c_layout) Bigarray.Array1.t

let () = assert (Obj.is_int (Obj.repr Unix.stdout))
let int_of_file_descr : Unix.file_descr -> int = Obj.magic

module File_descrs = struct
  type t = { mutable contents: Miou.syscall list array }

  let create n = { contents= Array.make (Stdlib.max n 16) [] }

  let grow tbl needed =
    let len = Array.length tbl.contents in
    let len' = ref len in
    while !len' <= needed do
      len' := !len' * 2
    done;
    let contents = Array.make !len' [] in
    Array.blit tbl.contents 0 contents 0 len;
    tbl.contents <- contents

  let get tbl fd =
    let i = int_of_file_descr fd in
    if i >= Array.length tbl.contents then [] else tbl.contents.(i)

  let set tbl fd syscalls =
    let i = int_of_file_descr fd in
    if i >= Array.length tbl.contents then grow tbl i;
    tbl.contents.(i) <- syscalls

  let clear tbl = Array.fill tbl.contents 0 (Array.length tbl.contents) []
end

(* NOTE(dinosaure): design note about [epoll(7)]:
   The main objective here is to provide four functions:
   - [blocking_read] / [blocking_write] (a suspension mechanism that Miou is
     able to _unblock_ or _resume_). These retain the _level-triggered_
     semantics (the semantics of [select]/[poll]/[ppoll]).
   - [retry_read] / [retry_write] corresponds to an execution path for file
     descriptors that are in _edge-triggered_ mode. It's a faster path, only
     valid right after a non-blocking syscall failed with [EAGAIN]

   ### Note about level-triggered/edge-triggered modes

   On other platforms, Miou uses [select]/[poll]/[ppoll], which only offer a
   _level-triggered_ semantic: a file descriptor is reported as long as it is
   ready (to read or write). [blocking_{read,write}] are exposed with this
   semantic: if a socket holds 512 bytes and the user reads only 256 of them,
   the next [blocking_read] resumes immediately, as 256 bytes remain.

   [epoll(7)] can provide the same semantic, but at a cost: with
   [EPOLLONESHOT], each wait requires an [epoll_ctl] to re-arm (re-register)
   the file descriptor, and without it, [EPOLLOUT] is reported again and again
   (a socket is almost always writable). We therefore register file descriptors
   in _edge-triggered_ mode: the kernel reports a file descriptor only when
   its state changes.

   ### How do we record file descriptors in the _edge triggered_ mode?

   A file descriptor is registered once, the first time a task waits on it,
   with [et_flags] ([IN | OUT | RDHUP | ET] = [read | write | shutdown
   | edge-triggered mode]): both directions (read & write), for the whole
   lifetime. The kernel can not tell us whether a file descriptor is
   registered, so each domain keeps an [armed] table which mirrors the kernel's
   registrations and saves us a redundant [EPOLL_CTL_ADD] on each wait. The
   expected invariant, for the domain which owns [domain.epoll], is:

   {[
     (Epoll.upd domain.epoll fd et_flags = 0) = is_armed domain fd
   ]}

   There are two ways to register a file descriptor. The first involves
   registration in _edge-triggered_ mode using [arm], which only calls
   [epoll_ctl] when absolutely necessary. The second method, [arm_and_poll],
   allows us to simulate _level-triggered_ mode by always calling
   [epoll_ctl]i: the kernel then re-evaluates the readiness of the file
   descriptor and queues an event if it is already ready, even if this
   readiness was already reported. Otherwise, nothing is reported until a new
   edge.

   ### How do we know that a file descriptor is ready?

   In edge-triggered mode, the kernel notifies us **only once** that there has
   been a change in the state of our file descriptors. The problem is that the
   information about this transition may arrive even when the user is not
   attempting to read from or write to the file descriptor whose state has
   changed.

   We must therefore _keep track of_ this state change in our [ready] array so
   as not to cause a suspension when the user attempts to read or write. Since
   the file descriptor is in non-blocking mode, the worst-case scenario is that
   we receive an [EAGAIN] error (if [ready] provides us with out-of-date
   information).

   The [select] function will therefore scan all events and, if the file
   descriptor has already been recorded in our table, we instruct Miou to
   resume the fibre that had been suspended. Otherwise, we record this
   information in our [ready] array (see [set_ready]).

   When the user wishes to read or write, we will check our [ready] array and
   decide whether or not to suspend operation based on this array (and
   depending on whether we want to be in level-triggered or edge-triggered
   mode). It is the [wait] function that decides whether or not to suspend
   operation. The read/write functions (in [miou_unix.common.ml.in]) must use
   [retry_{read,write}] if an [EAGAIN] error is encountered, or
   [blocking_{read,write}] in all other cases.
*)

type domain = {
    readers: File_descrs.t
  ; writers: File_descrs.t
  ; sleepers: Heapq.t
  ; rsleepers: (Miou.uid, elt) Hashtbl.t
  ; revert: (Miou.uid, Unix.file_descr) Hashtbl.t
  ; mutable epoll: Epoll.t
  ; events: Epoll.events
  ; armed: bytes
  ; ready: bytes
}

external max_open_files : unit -> int = "miou_unix_epoll_max_open_files"
[@@noalloc]

let flags_by_fd () = Bytes.make (max_open_files ()) '\000'

let is_armed domain fd =
  let idx = int_of_file_descr fd in
  idx < Bytes.length domain.armed && Bytes.unsafe_get domain.armed idx <> '\000'

let set_armed domain fd v =
  let idx = int_of_file_descr fd in
  if idx < Bytes.length domain.armed then
    Bytes.unsafe_set domain.armed idx (if v then '\001' else '\000')

let ready_r = 1
let ready_w = 2

let take_ready domain fd bit =
  let idx = int_of_file_descr fd in
  if idx < Bytes.length domain.ready then begin
    let v = Char.code (Bytes.unsafe_get domain.ready idx) in
    if v land bit <> 0 then begin
      Bytes.unsafe_set domain.ready idx (Char.unsafe_chr (v land lnot bit));
      true
    end
    else false
  end
  else false

let set_ready domain fd bit =
  let idx = int_of_file_descr fd in
  if idx < Bytes.length domain.ready then
    let v = Char.code (Bytes.unsafe_get domain.ready idx) in
    Bytes.unsafe_set domain.ready idx (Char.unsafe_chr (v lor bit))

let et_flags = Epoll.Flags.(epollin + epollout + epollrdhup + epollet)

let arm domain fd =
  if not (is_armed domain fd) then begin
    if Epoll.add domain.epoll fd et_flags = 0 then set_armed domain fd true
    else if Epoll.upd domain.epoll fd et_flags = 0 then set_armed domain fd true
  end

(* NOTE(dinosaure): for level-triggered mode, see [blocking_{read,write}]. *)
let arm_and_poll domain fd =
  let epoll = domain.epoll in
  if is_armed domain fd then begin
    if Epoll.upd epoll fd et_flags <> 0 then
      set_armed domain fd (Epoll.add epoll fd et_flags = 0)
  end
  else if Epoll.add epoll fd et_flags = 0 || Epoll.upd epoll fd et_flags = 0
  then set_armed domain fd true

let forget domain fd =
  let idx = int_of_file_descr fd in
  if idx < Bytes.length domain.armed then
    Bytes.unsafe_set domain.armed idx '\000';
  if idx < Bytes.length domain.ready then
    Bytes.unsafe_set domain.ready idx '\000'

(* NOTE(dinosaure): here, we keep domains to be able to forget a file
   descriptor across all of them. A file-descriptor can be used by one domain
   and closed by another. *)
let domains = Atomic.make []

let rec register domain =
  let old = Atomic.get domains in
  if not (Atomic.compare_and_set domains old (domain :: old)) then
    register domain

let rec unregister domain =
  let old = Atomic.get domains in
  let lst = List.filter (fun d -> d != domain) old in
  if not (Atomic.compare_and_set domains old lst) then unregister domain

(* NOTE(dinosaure): There are two scenarios in which the fact that a domain can
   modify [armed] and [ready] is not domain-safe. The first is an invalid POSIX
   scenario in which one domain attempts to close a file descriptor whilst, at
   the same time, another domain is attempting to read from or write to it. The
   second case is if an attempt is made to close a file descriptor A whilst a
   domain has just created a new one with the same value A (since, according to
   the kernel, slot A is now available following the closure):

   dom0: forget dom0.armed[A] <- 0; close(A)
   dom1: socket() -> A
   dom1: dom1.armed[A]

   In practice, close() and socket() access a global table shared across
   domains and internal to the kernel, which is protected by a lock. The order
   of [close_fd] is therefore very important:
   1) first [forget]
   2) then [Unix.close fd] (release [fd], cleaned on our side) *)
let forget_everywhere fd = List.iter (fun d -> forget d fd) (Atomic.get domains)

let close_fd fd =
  forget_everywhere fd;
  Unix.close fd

let clean domain uids =
  let clean uid' (fd : Unix.file_descr) tbl =
    match File_descrs.get tbl fd with
    | [] -> ()
    | syscalls ->
        File_descrs.set tbl fd
          (List.filter (fun s -> uid' <> Miou.uid s) syscalls)
  in
  let clean uid =
    match Hashtbl.find domain.revert uid with
    | fd ->
        clean uid fd domain.readers;
        clean uid fd domain.writers
    | exception Not_found -> ()
  in
  List.iter clean uids;
  List.iter (Hashtbl.remove domain.revert) uids;
  let clean uid =
    match Hashtbl.find_opt domain.rsleepers uid with
    | Some elt ->
      elt.cancelled <- true;
      Hashtbl.remove domain.rsleepers uid
    | None -> ()
  in
  List.iter clean uids

let domain =
  (* NOTE(dinosaure): see [miou_unix.poll.ml.in] for an explanation about
     [split_from_parent]. *)
  let rec split_from_parent v =
    File_descrs.clear v.readers;
    File_descrs.clear v.writers;
    drop_heapq v.sleepers;
    Hashtbl.clear v.rsleepers;
    Hashtbl.clear v.revert;
    Bytes.fill v.ready 0 (Bytes.length v.ready) '\000';
    for i = 0 to Bytes.length v.armed - 1 do
      if Bytes.unsafe_get v.armed i <> '\000' then begin
        ignore (Epoll.del v.epoll (Obj.magic i : Unix.file_descr));
        Bytes.unsafe_set v.armed i '\000'
      end
    done;
    make ()
  and make () =
    {
      readers= File_descrs.create 0x100
    ; writers= File_descrs.create 0x100
    ; sleepers= Heapq.create ()
    ; rsleepers= Hashtbl.create 0x100
    ; revert= Hashtbl.create 0x100
    ; epoll= Epoll.invalid_fd
    ; events= Epoll.events 256
    ; armed= flags_by_fd ()
    ; ready= flags_by_fd ()
    }
  in
  let key = Stdlib.Domain.DLS.new_key ~split_from_parent make in
  fun () -> Stdlib.Domain.DLS.get key

let append tbl fd syscall =
  File_descrs.set tbl fd (syscall :: File_descrs.get tbl fd)

let wait ~strict tbl bit ~name fd =
  let domain = domain () in
  let ready = take_ready domain fd bit in
  if strict || not ready then begin
    let syscall = Miou.syscall ~name () in
    let uid = Miou.uid syscall in
    let fn () =
      Hashtbl.replace domain.revert uid fd;
      append (tbl domain) fd syscall;
      if strict then arm_and_poll domain fd else arm domain fd
    in
    Miou.suspend ~fn syscall
  end

let readers domain = domain.readers
let writers domain = domain.writers

let blocking_read ?(name = "read") fd =
  wait ~strict:true readers ready_r ~name fd

let blocking_write ?(name = "write") fd =
  wait ~strict:true writers ready_w ~name fd

let retry_read ?(name = "read") fd = wait ~strict:false readers ready_r ~name fd

let retry_write ?(name = "write") fd =
  wait ~strict:false writers ready_w ~name fd

let close { fd; _ } = close_fd fd

let intr fd =
  let buf = Bytes.create 0x100 in
  match Unix.read fd buf 0 (Bytes.length buf) with
  | _ -> ()
  | exception Unix.(Unix_error (EAGAIN, _, _)) -> ()

let transmit_and_clean domain syscall =
  Hashtbl.remove domain.revert (Miou.uid syscall);
  Miou.signal syscall

let wakeup domain tbl fd =
  match File_descrs.get tbl fd with
  | [] -> []
  | syscalls ->
      File_descrs.set tbl fd [];
      List.rev_map (transmit_and_clean domain) syscalls

let select _uid ic ~block cancelled_syscalls =
  let domain = domain () in
  clean domain cancelled_syscalls;
  let timeout =
    match (sleeper domain.sleepers, block) with
    | None, true -> Epoll.Infinite
    | (None | Some _), false -> Epoll.No_wait
    | Some value, true ->
        let value = value -. Unix.gettimeofday () in
        let value = Float.max value 0.0 *. 1e9 in
        Epoll.Nanoseconds (Int64.of_float value)
  in
  match Epoll.wait domain.epoll domain.events timeout with
  | exception Unix.(Unix_error (EINTR, _, _)) ->
    collect domain.sleepers domain.rsleepers []
  | nready ->
      let acc = ref (collect domain.sleepers domain.rsleepers []) in
      let fn fd flags =
        if fd == ic then intr ic
        else begin
          let err = Epoll.Flags.(mem flags (epollerr + epollhup)) in
          let readable = err || Epoll.Flags.mem flags Epoll.Flags.epollin in
          let writable = err || Epoll.Flags.mem flags Epoll.Flags.epollout in
          let readable = readable || Epoll.Flags.(mem flags epollrdhup) in
          if readable || writable then begin
            let x =
              if readable then
                match wakeup domain domain.readers fd with
                | [] -> set_ready domain fd ready_r; []
                | x -> x
              else []
            in
            let y =
              if writable then
                match wakeup domain domain.writers fd with
                | [] -> set_ready domain fd ready_w; []
                | y -> y
              else []
            in
            acc := List.rev_append y (List.rev_append x !acc)
          end
        end
      in
      Epoll.iter domain.events nready fn;
      !acc

let signal = Bytes.make 1 '\000'

let interrupt oc () =
  match Unix.single_write oc signal 0 1 with
  | n -> assert (n = 1)
  | exception Unix.(Unix_error (EAGAIN, _, _)) -> ()
  | exception Unix.(Unix_error (EBADF, _, _)) -> ()

let events uid =
  let domain = domain () in
  domain.epoll <- Epoll.create ();
  let ic, oc = Unix.pipe ~cloexec:true () in
  Unix.set_nonblock ic;
  Unix.set_nonblock oc;
  (* NOTE(dinosaure): the interrupt pipe stays armed for the lifetime of the
     domain, so it is registered level-triggered (without [EPOLLET]): [intr]
     does not need to drain it. *)
  ignore (Epoll.add domain.epoll ic Epoll.Flags.epollin);
  register domain;
  let select = select uid ic in
  let finaliser () =
    unregister domain;
    Unix.close ic;
    Unix.close oc;
    Epoll.close domain.epoll;
    domain.epoll <- Epoll.invalid_fd;
    Bytes.fill domain.armed 0 (Bytes.length domain.armed) '\000';
    Bytes.fill domain.ready 0 (Bytes.length domain.ready) '\000'
  in
  { Miou.interrupt= interrupt oc; select; finaliser }

let run ?quanta ?poll ?g ?domains ?handler fn =
  Miou.run ?quanta ?poll ~events ?g ?domains ?handler fn
